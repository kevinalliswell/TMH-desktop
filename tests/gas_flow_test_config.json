{
  "test_config": {
    "description": "气体流量稳定性测试配置",
    "version": "1.0",
    "created": "2025-09-25"
  },
  "test_parameters": {
    "stability_check_interval": 2.0,
    "flow_tolerance": 0.1,
    "response_timeout": 5.0,
    "max_retry_attempts": 3,
    "settlement_time": 1.0
  },
  "test_scenarios": {
    "quick_test": {
      "description": "快速测试所有模式的基本功能",
      "duration": 60,
      "test_modes": ["comprehensive"],
      "gas_types": ["CO", "CO2", "N2", "H2"]
    },
    "standard_test": {
      "description": "标准稳定性测试",
      "duration": 300,
      "test_modes": ["comprehensive", "endurance"],
      "gas_types": ["CO", "CO2", "N2", "H2"]
    },
    "extended_test": {
      "description": "扩展耐久性测试",
      "duration": 1800,
      "test_modes": ["endurance"],
      "gas_types": ["CO", "CO2", "N2", "H2"],
      "cycles": 100
    }
  },
  "alert_thresholds": {
    "success_rate_min": 95.0,
    "response_time_max": 3.0,
    "flow_accuracy_min": 98.0,
    "flow_stability_max": 2.0
  },
  "reporting": {
    "generate_charts": true,
    "include_raw_data": true,
    "export_formats": ["txt", "json", "csv"],
    "auto_save": true
  }
}
